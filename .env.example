# OnlyFans API (app.onlyfansapi.com) — Bearer key, starts with ofapi_
# The dev/test key lives in .env (gitignored)
ONLYFANSAPI_API_KEY=

# P3 send-contract validation: id of an OWNER-CONTROLLED test fan (your own second
# OF account, subscribed to the FREE page) for the first live send checks.
# Leave empty to forbid any live test send — never point this at a real fan.
P3_SEND_TEST_FAN_ID=

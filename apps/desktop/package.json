{
  "name": "@chatgoose/desktop",
  "private": true,
  "version": "0.1.5",
  "description": "ChatGoose Desktop — Electron app",
  "author": "ChatGoose",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.test-web.json",
    "test": "vitest run",
    "build": "electron-vite build",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3-multiple-ciphers",
    "dist": "electron-vite build && electron-builder",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "node scripts/assert-win32.mjs && electron-vite build && electron-builder --win"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@fontsource-variable/hanken-grotesk": "^5.2.8",
    "@fontsource-variable/source-serif-4": "^5.2.9",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-virtual": "^3.14.2",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "bsqlite3-mc-node": "npm:better-sqlite3-multiple-ciphers@12.9.0",
    "electron": "^41.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.0",
    "vite": "^7.3.5",
    "vitest": "^4.1.8",
    "zustand": "^5.0.14"
  },
  "dependencies": {
    "better-sqlite3-multiple-ciphers": "^12.10.0",
    "electron-updater": "^6.8.9",
    "zod": "^4.4.3"
  }
}

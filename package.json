{
  "name": "chatgoose-desktop",
  "private": true,
  "version": "0.0.1",
  "description": "ChatGoose Desktop — OnlyFans chat workspace with built-in AI assistance",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r --no-bail typecheck",
